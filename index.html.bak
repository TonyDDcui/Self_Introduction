        }

        .nav-links { display: flex; gap: 24px; }
        .nav-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.875rem; }
        .nav-links a:hover { color: var(--text); }

        .theme-btn {
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            border-radius: 50%;
            background: var(--bg-secondary);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .theme-btn:hover { color: var(--text); border-color: var(--text-secondary); }

        .container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

        /* Hero */
        .hero {
            padding: 140px 0 80px;
            position: relative;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(ellipse at 30% 0%, rgba(88,166,255,0.12) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 100%, rgba(163,113,247,0.08) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-content {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 64px;
            align-items: center;
            position: relative;
        }

        .hero-text h1 {
            font-size: clamp(2.25rem, 5vw, 3.5rem);
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 16px;
        }

        .hero-text h1 .name {
            background: linear-gradient(135deg, #58a6ff, #a371f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .role {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.125rem;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .role .dot {
            width: 8px;
            height: 8px;
            background: var(--success);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .bio {
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.75;
            max-width: 560px;
        }

        .hero-stats {
            display: flex;
            gap: 32px;
            margin-top: 28px;
        }

        .hero-stat {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        .hero-stat strong { color: var(--text); }

        .hero-avatar {
            position: relative;
        }

        .hero-avatar img {
            width: 260px;
            height: 260px;
            border-radius: 50%;
            border: 4px solid var(--bg-tertiary);
            object-fit: cover;
        }

        /* GitHub Card */
        .github-section { padding: 20px 0 60px; }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 1.125rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .github-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
        }

        .contrib-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .contrib-text { font-size: 0.875rem; color: var(--text-secondary); }
        .contrib-text strong { color: var(--text); }

        .legend { display: flex; align-items: center; gap: 3px; font-size: 0.6875rem; color: var(--text-tertiary); }
        .legend-box { width: 11px; height: 11px; border-radius: 2px; background: var(--bg-tertiary); }
        .legend-box.l1 { background: #0e4429; }
        .legend-box.l2 { background: #006d32; }
        .legend-box.l3 { background: #26a641; }
        .legend-box.l4 { background: #39d353; }

        .contrib-grid { display: flex; gap: 3px; overflow-x: auto; }
        .contrib-week { display: flex; flex-direction: column; gap: 3px; }
        .contrib-day { width: 11px; height: 11px; border-radius: 2px; background: var(--bg-tertiary); }
        .contrib-day.l1 { background: #0e4429; }
        .contrib-day.l2 { background: #006d32; }
        .contrib-day.l3 { background: #26a641; }
        .contrib-day.l4 { background: #39d353; }

        /* Stats */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 16px; }

        .stat-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

