        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 0 5%;
            position: relative;
            z-index: 100;
        }

        .hero-content {
            width: 90%;
            max-width: 2250px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 4fr 1fr;
            gap: 100px;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .hero-text {
            text-align: left;
            position: relative;
            z-index: 2;
        }

        .hero-visual {
            display: flex;
            justify-content: center;
            align-items: center;
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            z-index: 3;
        }

        .hero-card {
            background: var(--glass-bg);
            backdrop-filter: saturate(180%) blur(40px);
            -webkit-backdrop-filter: saturate(180%) blur(40px);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            padding: 32px;
            transform-style: preserve-3d;
            transition: transform 0.1s ease-out;
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 800px;
            aspect-ratio: 2 / 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .virtual-avatar {
            width: 200px;
            height: 200px;
            background: linear-gradient(135deg, #0071e3 0%, #5856d6 50%, #bf5af2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            animation: float 6s ease-in-out infinite;
            box-shadow: 0 15px 45px rgba(0,0,0,0.2);
            border: 4px solid rgba(255, 255, 255, 0.3);
        }

        .virtual-avatar::before {
            content: '🐳';
            font-size: 60px;
            opacity: 0.9;
            animation: bounce 2s ease-in-out infinite;
        }

        .virtual-avatar::after {
            content: 'z';
            position: absolute;
            top: 50px;
            right: 50px;
            font-size: 24px;
            font-weight: bold;
            color: white;
            animation: sleep 3s ease-in-out infinite;
        }

        .virtual-avatar .bubble {
            position: absolute;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 50%;
            animation: float 3s ease-in-out infinite;
        }

        .virtual-avatar .bubble:nth-child(1) {
            width: 12px;
            height: 12px;
            top: 30px;
            right: 40px;
            animation-delay: 0s;
        }

        .virtual-avatar .bubble:nth-child(2) {
            width: 8px;
            height: 8px;
            top: 20px;
            right: 50px;
            animation-delay: 0.5s;
        }

        .virtual-avatar .bubble:nth-child(3) {
            width: 6px;
            height: 6px;
            top: 10px;
            right: 60px;
            animation-delay: 1s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        @keyframes sleep {
            0%, 100% { transform: rotate(0deg); }
            50% { transform: rotate(10deg); }
        }

        /* Section Divider */
        .section-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 48px;
            position: relative;
            z-index: 100;
        }

        .divider-capsule {
            width: 100%;
            max-width: 1280px;
            height: 4px;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 2px;
            position: relative;
            overflow: hidden;
        }

        .divider-capsule::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: linear-gradient(90deg, var(--accent-nvidia), transparent);
            width: 30%;
            animation: slide 3s ease-in-out infinite;
        }

        @keyframes slide {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(400%); }
        }

        /* Tech Stack Section - Animated */
        .tech-section {
            padding: 0 48px 60px;
            position: relative;
            z-index: 100;
        }

        .tech-container {
            max-width: 1280px;
            margin: 0 auto;
        }

        .tech-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
        }

        .tech-chip {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            perspective: 1000px;
            transform-style: preserve-3d;
        }

        .tech-chip:hover {
            border-color: var(--accent);
            transform: translateY(-6px) rotateX(5deg) rotateY(5deg);
            box-shadow: var(--shadow);
        }

        .tech-icon {
            font-size: 2rem;
            animation: bounce 2s infinite;
            display: inline-block;
        }

        .tech-chip:nth-child(2) .tech-icon { animation-delay: 0.1s; }
        .tech-chip:nth-child(3) .tech-icon { animation-delay: 0.2s; }
        .tech-chip:nth-child(4) .tech-icon { animation-delay: 0.3s; }
        .tech-chip:nth-child(5) .tech-icon { animation-delay: 0.4s; }
        .tech-chip:nth-child(6) .tech-icon { animation-delay: 0.5s; }
        .tech-chip:nth-child(7) .tech-icon { animation-delay: 0.6s; }
        .tech-chip:nth-child(8) .tech-icon { animation-delay: 0.7s; }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .tech-name {
            font-size: 1rem;
            font-weight: 700;
        }

