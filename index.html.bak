        /* Fade */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .fade-in.visible { opacity: 1; transform: translateY(0); }

        .fade-in-stagger > * {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        .fade-in-stagger.visible > * { opacity: 1; transform: translateY(0); }
        .fade-in-stagger.visible > *:nth-child(1) { transition-delay: 0.1s; }
        .fade-in-stagger.visible > *:nth-child(2) { transition-delay: 0.15s; }
        .fade-in-stagger.visible > *:nth-child(3) { transition-delay: 0.2s; }
        .fade-in-stagger.visible > *:nth-child(4) { transition-delay: 0.25s; }
        .fade-in-stagger.visible > *:nth-child(5) { transition-delay: 0.3s; }

        /* About Section */
        .about-section {
            padding: 40px 48px 60px;
            position: relative;
            z-index: 100;
        }

        .about-container {
            max-width: 1280px;
            margin: 0 auto;
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 240px;
            gap: 32px;
            align-items: center;
        }

        .about-text h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--text);
        }

        .about-subtitle {
            font-size: 0.875rem;
            color: var(--accent-nvidia);
            font-weight: 600;
            margin-bottom: 16px;
        }

        .about-description {
            font-size: 0.875rem;
            line-height: 1.5;
            color: var(--text-secondary);
            margin-bottom: 24px;
        }

        .about-stats {
            display: flex;
            gap: 32px;
        }

        .about-stat {
            text-align: center;
        }

        .stat-number {
            display: block;
            font-size: 2rem;
            font-weight: 800;
            color: var(--accent-nvidia);
        }

        .stat-label {
            display: block;
            font-size: 0.75rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .about-image {
            display: flex;
            justify-content: center;
        }

        .about-avatar {
            width: 160px;
            height: 160px;
            border-radius: 12px;
            overflow: hidden;
            border: 3px solid var(--accent-nvidia);
            background: linear-gradient(135deg, var(--accent-nvidia), #5a9200);
        }

        .about-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* NVIDIA Style Sections */
        .nvidia-section {
            padding: 40px 48px 60px;
            position: relative;
            z-index: 100;
        }

        .nvidia-container {
            max-width: 1280px;
            margin: 0 auto;
        }

        /* NVIDIA Progress Bar */
        .nvidia-progress {
            height: 3px;
            background: #e0e0e0;
            margin-bottom: 24px;
            overflow: hidden;
        }

        .nvidia-progress-bar {
            height: 100%;
            background: var(--accent-nvidia);
            width: 25%;
            transition: width 0.3s ease;
        }

        .nvidia-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        .nvidia-header h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 8px;
        }

        .nvidia-subtitle {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-left: 0;
            max-width: 600px;
            line-height: 1.4;
        }

        .nvidia-nav {
            position: absolute;
            top: 40px;
            right: 48px;
            display: flex;
            gap: 8px;
        }

        .nav-arrow {
            width: 32px;
            height: 32px;
            border: 1px solid var(--border);
            background: var(--bg-elevated);
            color: var(--text);
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .nav-arrow:hover {
            background: var(--accent-nvidia);
            color: white;
            border-color: var(--accent-nvidia);
        }

        .nvidia-content-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            align-items: flex-start;
        }

        .nvidia-text-content {
            max-width: 500px;
        }

        .nvidia-text-content p {
            font-size: 0.875rem;
            line-height: 1.5;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .nvidia-fast-links {
            margin-top: 24px;
        }

        .nvidia-fast-links h4 {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nvidia-fast-links h4::before {
            content: '▼';
            font-size: 0.7rem;
            color: var(--accent-nvidia);
        }

        .nvidia-link-list {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .nvidia-link-list li {
            font-size: 0.75rem;
        }

        .nvidia-link-list a {
            color: var(--text);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .nvidia-link-list a:hover {
            color: var(--accent-nvidia);
        }

        .nvidia-image-content {
            position: relative;
        }

        .nvidia-main-image {
            width: 100%;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .nvidia-main-image img {
            width: 100%;
            height: auto;
            object-fit: cover;
        }

        .nvidia-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .nvidia-card {
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            text-decoration: none;
            color: var(--text);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .nvidia-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            border-color: var(--accent-nvidia);
        }

        .nvidia-image {
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nvidia-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .nvidia-content {
            padding: 16px;
            flex: 1;
        }

        .nvidia-content h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .nvidia-content p {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.3;
        }

        /* GitHub Section */
        .github-section {
            padding: 60px 48px;
